{
  "name": "dayflow",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered Adaptive Habit Tracker - Local-First Web/PWA + Windows Desktop",
  "author": "DayFlow",
  "main": "electron/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "electron:dev": "concurrently -k \"next dev\" \"wait-on http://localhost:3000 && electron . --dev\"",
    "electron:preview": "next build && node scripts/prepare-standalone.js && electron .",
    "pack": "next build && node scripts/prepare-standalone.js && electron-builder --win --x64 --dir",
    "dist": "next build && node scripts/prepare-standalone.js && electron-builder --win --x64"
  },
  "dependencies": {
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.45.4",
    "@testing-library/jest-dom": "6.4.2",
    "@testing-library/react": "16.0.0",
    "@testing-library/user-event": "14.5.2",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.14.11",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "concurrently": "^8.2.2",
    "date-fns": "3.6.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.15",
    "idb": "8.0.0",
    "js-sha256": "0.9.0",
    "jsdom": "24.1.0",
    "lucide-react": "0.453.0",
    "pdf-parse": "^2.4.5",
    "postcss": "8.4.41",
    "tailwind-merge": "2.5.2",
    "tailwindcss": "3.4.10",
    "typescript": "5.5.4",
    "vitest": "2.0.5",
    "wait-on": "^7.2.0",
    "zod": "3.23.8",
    "zustand": "4.5.5"
  }
}
