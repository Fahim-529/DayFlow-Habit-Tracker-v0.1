{
  "productName": "DayFlow",
  "appId": "com.dayflow.app",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "electron/main/index.js",
    "electron/preload/index.js",
    "package.json"
  ],
  "extraResources": [
    {
      "from": ".next/standalone",
      "to": "standalone"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "build/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "DayFlow",
    "artifactName": "DayFlow-Setup-${version}.exe"
  },
  "publish": null,
  "electronFuses": {
    "runAsNode": true
  }
}
